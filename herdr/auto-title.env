# Auto Title v0.13.2: único renombrador de pestañas y paneles de Herdr.
# La configuración se lee al arrancar; aplicar con herdr.auto-title.restart.
# No genera nombres de sesiones de Pi ni lee sus conversaciones.
HERDR_AUTO_TITLE_POLL_MS=500
HERDR_AUTO_TITLE_MAX_LENGTH=50
HERDR_AUTO_TITLE_BRANCH_MAX=12
HERDR_AUTO_TITLE_POSITION=true
HERDR_AUTO_TITLE_PANES=true
HERDR_AUTO_TITLE_WORKSPACES=true
HERDR_AUTO_TITLE_AGENT_NAME=true
HERDR_AUTO_TITLE_PREFER_AGENT=false
HERDR_AUTO_TITLE_PANE_ID=false
# Pi es el harness principal; no buscar transcripciones de Claude.
HERDR_AUTO_TITLE_TRANSCRIPT=false
HERDR_AUTO_TITLE_DEBUG=false
# manual-names.json es estado local; no se enlaza ni se versiona.
