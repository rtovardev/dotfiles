+    def pi_title(self, session_path: str) -> str:
+        # Use only the exact file reported by Herdr, including custom session
+        # directories. Do not guess the newest session from a shared cwd.
+        if (not isinstance(session_path, str) or not Path(session_path).is_absolute()
+                or Path(session_path).suffix != ".jsonl"):
