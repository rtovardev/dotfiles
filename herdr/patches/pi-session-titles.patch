diff --git a/tests/test_pi_titles.py b/tests/test_pi_titles.py
new file mode 100644
index 0000000..1db51bc
--- /dev/null
+++ b/tests/test_pi_titles.py
@@ -0,0 +1,209 @@
+"""Local Pi support: read saved names without changing Pi or calling a model."""
+import copy
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from herdr_bar.auto_title import MAX_SCAN, AutoTitles, TranscriptReader
+from herdr_bar.config import Config
+from herdr_bar.tab_status import TabStatus
+
+from .test_app import FakeClient
+from .test_auto_title import snapshot
+
+
+class PiReaderTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name) / "custom-session.jsonl"
+        self.reader = TranscriptReader([])
+
+    def write(self, *records):
+        with self.path.open("a") as handle:
+            for record in records:
+                handle.write(json.dumps(record) + "\n")
+
+    def title(self):
+        return self.reader.pi_title(str(self.path))
+
+    def test_latest_saved_name_wins_and_controls_are_removed(self):
+        self.write({"type": "session", "id": "pi-id"},
+                   {"type": "message", "message": {"role": "user", "content": "Not a title"}},
+                   {"type": "session_info", "name": "First task"})
+        self.assertEqual(self.title(), "First task")
+        self.write({"type": "session_info", "name": "\x1b[31mRepair\x1b[0m\nlogin\x07"})
+        self.assertEqual(self.title(), "Repair login")
+
+    def test_unnamed_session_does_not_use_prompt_or_claude_metadata(self):
+        self.write({"type": "ai-title", "aiTitle": "Claude title"},
+                   {"type": "message", "message": {"role": "user", "content": "Secret prompt"}})
+        self.assertEqual(self.title(), "")
+
+    def test_bad_records_and_partial_name_wait_for_newline(self):
+        self.path.write_bytes(b'not json\n[]\n{"type":"session_info","name":5}\n'
+                              b'{"type":"session_info","name":"Fix')
+        self.assertEqual(self.title(), "")
+        with self.path.open("ab") as handle:
+            handle.write(b' auth"}\n')
+        self.assertEqual(self.title(), "Fix auth")
+
+    def test_missing_deleted_and_rewritten_files_recover_without_stale_names(self):
+        self.assertEqual(self.title(), "")
+        self.write({"type": "session_info", "name": "Old title"})
+        self.assertEqual(self.title(), "Old title")
+        self.path.write_text(json.dumps({"type": "session_info", "name": "New title"}) + "\n")
+        self.assertEqual(self.title(), "New title")
+        self.path.write_text('{}\n')
+        self.assertEqual(self.title(), "")
+        self.path.unlink()
+        self.assertEqual(self.title(), "")
+        self.write({"type": "session_info", "name": "Recovered"})
+        self.assertEqual(self.title(), "Recovered")
+
+    def test_only_absolute_jsonl_paths_are_accepted(self):
+        for value in ("relative.jsonl", "../private.jsonl", "/tmp/private.txt", "", None, 5):
+            with self.subTest(value=value):
+                self.assertEqual(self.reader.pi_title(value), "")
+        self.assertEqual(self.reader.sessions, {})
+
+    def test_large_session_keeps_early_name_and_catches_up_in_bounded_chunks(self):
+        self.write({"type": "session_info", "name": "Early title"})
+        with self.path.open("ab") as handle:
+            handle.write(b'{"type":"message","payload":"' + b'x' * (MAX_SCAN * 2) + b'"}\n')
+        self.write({"type": "session_info", "name": "Latest title"})
+        self.assertEqual(self.title(), "Early title")
+        self.assertEqual(self.title(), "Early title")
+        self.assertEqual(self.title(), "Early title")
+        self.assertEqual(self.title(), "Latest title")
+        self.assertEqual(self.title(), "Latest title")
+
+
+class PiAutoTitlesTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name) / "session.jsonl"
+        self.name("Pi task")
+        env = patch.dict(os.environ, {"HERDR_AUTO_TITLE_TRANSCRIPT": "true",
+                                      "HERDR_PLUGIN_STATE_DIR": self.temp.name,
+                                      "HERDR_SOCKET_PATH": "/test/pi-server.sock"})
+        env.start()
+        self.addCleanup(env.stop)
+        config = patch.object(Config, "load", return_value=Config({"auto_titles": True}))
+        config.start()
+        self.addCleanup(config.stop)
+        data = snapshot()
+        agent = data["agents"][0]
+        agent["agent"] = "pi"
+        agent["terminal_title_stripped"] = "π - app"
+        agent["agent_session"] = {"agent": "pi", "kind": "path", "value": str(self.path)}
+        self.client = FakeClient(data)
+        self.titles = AutoTitles()
+
+    def name(self, value):
+        with self.path.open("a") as handle:
+            handle.write(json.dumps({"type": "session_info", "name": value}) + "\n")
+
+    def apply(self):
+        return self.titles.apply(self.client, copy.deepcopy(self.client.snapshot()))
+
+    def test_pi_name_updates_survive_restart_and_lowercase_configuration(self):
+        self.apply()
+        self.assertEqual(self.client.calls[-1], ("rename", "w1:t9", "Pi task"))
+        self.name("Repair OAuth")
+        self.apply()
+        self.assertEqual(self.client.calls[-1][-1], "Repair OAuth")
+        self.titles = AutoTitles()
+        self.titles.configure(Config({"lowercase_titles": True}))
+        self.apply()
+        self.assertEqual(self.client.calls[-1][-1], "repair oauth")
+
+    def test_session_metadata_can_be_reported_on_the_pane(self):
+        data = self.client._snapshot
+        data["panes"][0]["agent_session"] = data["agents"][0].pop("agent_session")
+        self.apply()
+        self.assertEqual(self.client.calls[-1][-1], "Pi task")
+
+    def test_missing_name_waits_for_pi_instead_of_using_generic_terminal_title(self):
+        self.path.write_text('{}\n')
+        self.apply()
+        self.assertEqual(self.client.calls, [])
+        self.name("Generated later")
+        self.apply()
+        self.assertEqual(self.client.calls[-1][-1], "Generated later")
+
+    def test_custom_tab_pane_agent_conflicts_and_multiple_agents_are_preserved(self):
+        original = copy.deepcopy(self.client._snapshot)
+        for group, key, value in (("tabs", "label", "My work"),
+                                  ("panes", "label", "My pane"),
+                                  ("agents", "name", "my-agent"),
+                                  ("tabs", "title_conflict", True)):
+            with self.subTest(group=group):
+                self.client._snapshot = copy.deepcopy(original)
+                self.client._snapshot[group][0][key] = value
+                self.apply()
+                self.assertEqual(self.client.calls, [])
+        self.client._snapshot = copy.deepcopy(original)
+        self.client._snapshot["agents"].append(dict(original["agents"][0], pane_id="other"))
+        self.apply()
+        self.assertEqual(self.client.calls, [])
+
+    def test_manual_rename_and_replacement_session_cannot_claim_owned_title(self):
+        self.apply()
+        original = copy.deepcopy(self.client._snapshot)
+        self.client._snapshot["tabs"][0]["label"] = "Manual"
+        self.name("New task")
+        self.apply()
+        self.assertEqual(len(self.client.calls), 1)
+        self.client._snapshot = original
+        self.client._snapshot["agents"][0]["agent_session"]["value"] = str(self.path.with_name("other.jsonl"))
+        self.titles = AutoTitles()
+        self.apply()
+        self.assertEqual(len(self.client.calls), 1)
+
+    def test_invalid_or_mismatched_metadata_and_sessionless_pi_are_ignored(self):
+        original = copy.deepcopy(self.client._snapshot)
+        for session in (None, {"agent": "claude", "kind": "path", "value": str(self.path)},
+                        {"agent": "pi", "kind": "id", "value": str(self.path)},
+                        {"agent": "pi", "kind": "path", "value": "relative.jsonl"}):
+            with self.subTest(session=session):
+                self.client._snapshot = copy.deepcopy(original)
+                self.client._snapshot["agents"][0]["agent_session"] = session
+                self.apply()
+                self.assertEqual(self.client.calls, [])
+
+    def test_session_switch_during_read_cancels_rename(self):
+        def read(path):
+            self.client._snapshot["agents"][0]["agent_session"]["value"] = "/tmp/other.jsonl"
+            return "Old task"
+        with patch.object(self.titles.reader, "pi_title", side_effect=read):
+            self.apply()
+        self.assertEqual(self.client.calls, [])
+
+    def test_opt_out_skips_pi_session_reads(self):
+        self.titles.configure(Config({"auto_titles": False}))
+        with patch.object(self.titles.reader, "pi_title") as read:
+            self.apply()
+            read.assert_not_called()
+        self.assertEqual(self.client.calls, [])
+
+    def test_titles_work_through_status_wrapper_without_duplicate_prefixes(self):
+        tabs = TabStatus(self.client, self.titles.state_dir)
+        tabs.configure(Config({"tab_status": True}))
+        data = self.client._snapshot
+        data["agents"][0]["agent_status"] = "working"
+        data["panes"][0]["agent"] = "pi"
+        data["panes"][0]["agent_status"] = "working"
+        for _ in range(2):
+            renamed = self.titles.apply(tabs, tabs.snapshot())
+            tabs.apply(renamed)
+        label = self.client._snapshot["tabs"][0]["label"]
+        self.assertTrue(label.endswith("Pi task"), label)
+        self.assertEqual(label.count("Pi task"), 1)
+        self.name("Updated task")
+        tabs.apply(self.titles.apply(tabs, tabs.snapshot()))
+        self.assertTrue(self.client._snapshot["tabs"][0]["label"].endswith("Updated task"))
