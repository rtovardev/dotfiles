#!/bin/sh
# Compatibility aliases use the unmodified Herdr Account Switch backend.
set -eu
plugin="$HOME/.local/state/herdr/plugins/rcosteira.account-switch/current/switcher.py"
if [ ! -f "$plugin" ]; then
    echo "Account Switch no está instalado. Ejecuta: herdr plugin install rcosteira79/herdr-account-switch" >&2
    exit 1
fi
case "${1:-status}" in
    status|ls|list) exec python3 "$plugin" status ;;
    mart|trabajo) python3 "$plugin" switch codex mart && pkill -f "codex.*app-server" 2>/dev/null; rm -rf "/private/tmp/codex-daemon-$(id -u)"/* 2>/dev/null; echo "codex: daemon reiniciado; las TUIs vivas quedan en la cuenta anterior (corre cs update)" ;;
    personal|home) python3 "$plugin" switch codex personal && pkill -f "codex.*app-server" 2>/dev/null; rm -rf "/private/tmp/codex-daemon-$(id -u)"/* 2>/dev/null; echo "codex: daemon reiniciado; las TUIs vivas quedan en la cuenta anterior (corre cs update)" ;;
    open) exec herdr plugin pane open --plugin rcosteira.account-switch --entrypoint picker --env TERM=xterm-256color ;;
    update|reload) shift; exec python3 "$HOME/.local/bin/codex-reload" "$@" ;;
    *) echo "Uso: codex-switch {status|mart|personal|open|update [personal|mart|both]}" >&2; exit 2 ;;
esac
